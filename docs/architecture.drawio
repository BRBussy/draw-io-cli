<mxfile><diagram name="Architecture" id="architecture"><mxGraphModel grid="0" page="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="architecture-title" value="One CLI, two asset routes" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#456078;strokeWidth=2;fontColor=#172b4d;fontSize=28;spacing=12;"><mxGeometry x="40" y="20" width="980" height="60" as="geometry" /></mxCell><mxCell id="laptop-extension" value="LAPTOP: VS CODE / CURSOR&#10;Extension bundles the webapp&#10;Editor opens editable diagrams" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#456078;strokeWidth=2;fontColor=#172b4d;fontSize=17;spacing=12;"><mxGeometry x="40" y="140" width="260" height="120" as="geometry" /></mxCell><mxCell id="webapp-assets" value="DRAW.IO WEBAPP ASSETS&#10;Local scripts, fonts and shapes&#10;Shared renderer bootstrap" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fe;strokeColor=#456078;strokeWidth=2;fontColor=#172b4d;fontSize=17;spacing=12;"><mxGeometry x="380" y="140" width="280" height="120" as="geometry" /></mxCell><mxCell id="server-assets" value="LINUX SERVER: STANDALONE&#10;Pinned archive + SHA-256&#10;No editor required" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#456078;strokeWidth=2;fontColor=#172b4d;fontSize=17;spacing=12;"><mxGeometry x="760" y="140" width="260" height="120" as="geometry" /></mxCell><mxCell id="diagram-cli" value="DRAWIO-CLI&#10;Extract, edit, lint and render&#10;Claude Code / Codex skills" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f0fe;strokeColor=#456078;strokeWidth=2;fontColor=#172b4d;fontSize=17;spacing=12;"><mxGeometry x="40" y="350" width="260" height="100" as="geometry" /></mxCell><mxCell id="headless-browser" value="HEADLESS CHROMIUM&#10;Playwright drives draw.io&#10;Only renderer-local requests" vertex="1"